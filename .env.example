# Leave SEND21_API_KEY empty to run the whole loop locally (mock send21).

# --- send21 (https://send21.io/api-keys, scope drafts:write; + webhooks:manage to register) ---
SEND21_API_KEY=
SEND21_WEBHOOK_SECRET=
PUBLIC_URL=http://localhost:3000

# --- Where you get paid: YOUR own addresses (coin ids in src/currencies.ts) ---
PAY_LIGHTNING=
PAY_OPTIONS=usdc-sol:<your Solana address>,usdt-sol:<your Solana address>

# --- Secrets (openssl rand -base64url 32 style values, two different ones) ---
# Dashboard login, at least 24 characters
STREAMER_TOKEN=
# The OBS overlay URL is /overlay/<OVERLAY_KEY>: 32-128 of A-Z a-z 0-9 _ -
OVERLAY_KEY=

# --- Stream ---
# STREAM_FILE=./stream.json
# extra words to mask, comma separated
BLOCKED_WORDS=
LINK_EXPIRY_HOURS=1
SHORTFALL_PERCENT=0
PORT=3000
DATA_FILE=./data/tips.json
# TRUST_PROXY=1
